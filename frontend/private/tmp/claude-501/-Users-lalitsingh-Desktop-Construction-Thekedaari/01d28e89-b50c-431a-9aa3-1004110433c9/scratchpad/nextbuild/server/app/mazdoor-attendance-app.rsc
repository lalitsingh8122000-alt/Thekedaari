        <div class="float-card fc-3"><div class="float-icon">💼</div><div><strong>Worker Ledger</strong><span>Payment linked records</span></div></div>
        <div class="float-card fc-4"><div class="float-icon">📲</div><div><strong>Mobile Entry</strong><span>On-site quick update</span></div></div>
        <div class="phone">
          <div class="screen">

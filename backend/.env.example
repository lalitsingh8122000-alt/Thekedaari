DB_TARGET="local"
DATABASE_URL_LOCAL="mysql://thekedaar:Thekedaar%40Prod2026@localhost:3306/thekedaar_db"
DATABASE_URL_AWS="mysql://username:password@aws-rds-host:3306/thekedaar_db"
JWT_SECRET="CHANGE-THIS-to-a-long-random-string-use-openssl-rand-hex-32"
PORT=5000

# ── Subscription ────────────────────────────────────────────────────────────────
# Master switch. Set to false to unlock the whole app for everyone again.
SUBSCRIPTION_ENABLED=true
# Free days every new signup starts with. 0 = pay before first use (no grandfathering).
SUBSCRIPTION_TRIAL_DAYS=0
# Extra days the app keeps working after expiry. 0 = hard stop on the expiry date.
SUBSCRIPTION_GRACE_DAYS=0
# Renewal banner starts this many days before expiry.
SUBSCRIPTION_REMINDER_DAYS=7
# Shown on the paywall and on payment errors (10 digits, no +91).
SUPPORT_PHONE=

# ── Razorpay ────────────────────────────────────────────────────────────────────
# THIS FILE IS PER-ENVIRONMENT AND GITIGNORED (.env) — keys never travel with a push.
#   local dev  -> rzp_test_*  (never live keys: real cards get charged)
#   production -> rzp_live_*  (set directly in the .env on the server)
# From Dashboard -> Settings -> API Keys. Switch the dashboard to Live mode first.
# Leave blank to keep checkout disabled: the app then shows a clean
# "payments not live yet" message instead of failing.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Any long random string (openssl rand -hex 24). Put the SAME value in
# Dashboard -> Settings -> Webhooks, pointing at:
#   https://your-domain.com/api/subscription/webhook
# and subscribe to payment.captured, order.paid and payment.failed.
# Test mode and Live mode have separate webhooks — add it in both.
RAZORPAY_WEBHOOK_SECRET=

# ── Admin ───────────────────────────────────────────────────────────────────────
# Long random string. Enables POST /api/subscription/admin/grant via the x-admin-key header.
ADMIN_API_KEY=
